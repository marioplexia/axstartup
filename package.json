{
  "name": "axai-prea-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "nightly": "tsx --env-file-if-exists=.env scripts/nightly.ts",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "eval:retro": "tsx --env-file-if-exists=.env scripts/eval-retro.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "redact:report": "tsx --env-file-if-exists=.env scripts/redact-report.ts",
    "live:compare": "tsx --env-file-if-exists=.env scripts/live-compare.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
