# Copiar a .env. Nunca commitear secretos ni datos reales.
DATABASE_URL=postgres://axai:axai@localhost:5432/axai
JWT_SECRET=cambia-esto
PII_SALT=cambia-esto-en-produccion   # sal del hash de VIN y de autores; si cambia, los hashes viejos dejan de coincidir
ANTHROPIC_API_KEY=
LLM_MODE=mock            # mock | live (live exige payloads redactados y sellados)
LLM_MODEL=claude-haiku-5-5
# Tarifas vigentes de tu contrato, en USD por MILLÓN de tokens. Sin ellas los reportes muestran costo n/d.
LLM_PRICE_IN=
LLM_PRICE_OUT=
